{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            merchant_id,\n            wallet_id,\n            currency,\n            SUM(amount_minor) AS \"gross_minor!: i64\",\n            SUM(fee_minor)    AS \"fee_minor!: i64\",\n            COUNT(*)::INTEGER AS \"tx_count!: i32\"\n        FROM   transactions\n        WHERE  status     = 'CAPTURED'\n          AND  created_at >= $1\n          AND  created_at <  $2\n        GROUP  BY merchant_id, wallet_id, currency\n        ",
