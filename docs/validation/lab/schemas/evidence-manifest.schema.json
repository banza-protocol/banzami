{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "banzami.validation.evidence-manifest/1",
  "title": "Validation Evidence Manifest",
  "description": "One per journey, written into the evidence store. A journey cannot be PASS unless every evidence_required type on it resolves to an artifact here.",
  "type": "object",
  "required": ["manifest_version", "run_id", "suite_id", "journey_id", "artifacts", "manifest_sha256"],
  "additionalProperties": false,
  "properties": {
    "manifest_version": { "const": 1 },
    "run_id":   { "type": "string", "pattern": "^BZV-[0-9]{8}-[0-9]{4}-[0-9a-f]{8}$" },
    "suite_id": { "type": "string", "pattern": "^S[0-9]{2}$" },
    "journey_id": { "type": "string", "pattern": "^S[0-9]{2}-[A-Z]{3}-[0-9]{3}$" },
    "verdict": {
      "enum": ["PASS", "PASS_WITH_RETRY", "FAIL", "NOT_IMPLEMENTED",
               "EXTERNAL_DEPENDENCY", "OUT_OF_SCOPE", "DEPRECATED", "UNKNOWN"]
    },
    "evidence_mode": {
      "enum": ["AUTOMATED", "MANUAL_USER_VERIFIED"],
      "description": "Manual evidence is legitimate but must never masquerade as automated. A Golden Run reports the MANUAL count as a headline number."
    },
    "attempts": {
      "type": "array",
      "description": "Every attempt, with its retry reason. Retries diagnose infrastructure; they never manufacture a PASS.",
      "items": {
        "type": "object",
        "required": ["n", "outcome"],
        "properties": {
          "n": { "type": "integer", "minimum": 1 },
          "outcome": { "type": "string" },
          "retry_reason": { "type": "string" },
          "failure_class": { "enum": ["assertion", "infrastructure", "timeout", "provider"] }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["artifact_id", "artifact_type", "path", "sha256", "created_at", "redaction"],
        "additionalProperties": false,
        "properties": {
          "artifact_id":   { "type": "string" },
          "capability_id": { "type": "string", "pattern": "^CAP-[A-Z]+-[0-9]{3}$" },
          "artifact_type": {
            "enum": ["screenshot", "video", "trace", "har", "api_log", "qr_image",
                     "camera_input", "ledger_extract", "balance_snapshot",
                     "receipt_pdf", "verification_result", "webhook_payload",
                     "email_metadata", "sdk_install_log", "sdk_runtime_output",
                     "build_report", "db_invariant", "service_log"]
          },
          "path":   { "type": "string", "description": "relative to the run directory" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "bytes":  { "type": "integer", "minimum": 0 },
          "created_at": { "type": "string", "format": "date-time" },
          "redaction": {
            "type": "object",
            "required": ["applied"],
            "properties": {
              "applied":  { "type": "boolean" },
              "patterns": { "type": "array", "items": { "type": "string" } },
              "reason":   { "type": "string" }
            },
            "description": "Redaction runs at the WRITER, so an unredacted artifact never exists on disk. A post-run scan re-checks every artifact; a hit is EVIDENCE_SECRET_LEAK = FAIL, classified as a defect of the Validation Lab, and it voids the run."
          },
          "source":      { "type": "string" },
          "description": { "type": "string" }
        }
      }
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "Computed over the artifact list with this field excluded. The run-level run-result.json records every journey manifest hash, making the evidence set tamper-evident as a whole."
    }
  }
}
