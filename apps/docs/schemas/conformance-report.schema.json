{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://banzami.com/schemas/conformance-report.schema.json",
  "title": "Banzami Conformance Report",
  "description": "Schema for conformance report summaries stored in the operator registry.",
  "type": "object",

  "required": [
    "protocol_version",
    "certification_level",
    "conformance_badges",
    "passed_suites",
    "failed_suites",
    "timestamp",
    "report_hash",
    "runner_version"
  ],

  "properties": {
    "protocol_version": { "type": "string", "pattern": "^\\d+\\.\\d+$" },
    "certification_level": { "type": "integer", "minimum": -1, "maximum": 4 },
    "certification_level_name": { "type": "string" },
    "conformance_badges": {
      "type": "array",
      "items": { "type": "string", "enum": ["protocol-compatible", "trace-compatible", "federation-ready", "settlement-compatible"] }
    },
    "passed_suites": { "type": "array", "items": { "type": "string" } },
    "failed_suites": { "type": "array", "items": { "type": "string" } },
    "invariant_violations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["invariant_id", "description"],
        "properties": {
          "invariant_id": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    },
    "timestamp": { "type": "string", "format": "date-time" },
    "report_hash": { "type": "string" },
    "runner_version": { "type": "string" }
  },

  "additionalProperties": true
}
