      },
      "pass_condition": {
        "pt": "Parecer de prontidão emitido.",
        "en": "Readiness assessment issued."
      },
      "does_not_authorize": {
        "pt": "Aprovação de Produção.",
        "en": "Production approval."
      }
    },
    {
      "n": 9,
      "name": {
        "en": "Regulatory/legal review gate",
        "pt": "Portão de revisão regulatória/legal"
      },
      "purpose": {
        "pt": "Enquadramento antes de qualquer fase supervisionada.",
        "en": "Framing before any supervised phase."
      },
      "required_evidence": {
        "pt": "Revisão regulatória/legal própria.",
        "en": "Own regulatory/legal review."
      },
      "pass_condition": {
        "pt": "Fora do âmbito desta documentação.",
        "en": "Outside the scope of this documentation."
      },
      "does_not_authorize": {
        "pt": "Autorização regulatória.",
        "en": "Regulatory authorization."
