      "required_evidence": {
        "pt": "Checklist de validação com evidência.",
        "en": "Validation checklist with evidence."
      },
      "pass_condition": {
        "pt": "Checklist completo.",
        "en": "Checklist complete."
      },
      "does_not_authorize": {
        "pt": "Ativação de trilhos live.",
        "en": "Live rails activation."
      }
    },
    {
