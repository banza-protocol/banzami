        "en": "Ensure all documentation reflects evidence."
      },
      "required_evidence": {
        "pt": "Suites de testes de claims a passar.",
        "en": "Claim-safety test suites passing."
      },
      "pass_condition": {
        "pt": "Todos os testes de documentação verdes.",
        "en": "All documentation tests green."
