# Container log retention on the Banzami Sandbox host (217.160.9.248).
# Installed as /etc/logrotate.d/banzami-container-logs; run by the host's
# logrotate.service (daily). Policy: docs/operations/LOG_RETENTION.md.
#
# Docker's json-file driver had no size or file limit on this host and there was
# no daemon.json, so every container log — the nginx access logs included — grew
# for as long as the container lived (banzami.com's since July). Rotated daily or
# at 50M, kept 14 days (the host's local backup retention), then deleted.
# copytruncate: Docker keeps the file open and appends; the container is never
# restarted to rotate.
/var/lib/docker/containers/*/*-json.log {
    su root root
    daily
    maxsize 50M
    rotate 14
    maxage 14
    missingok
    notifempty
    copytruncate
    compress
    delaycompress
    dateext
    dateformat -%Y%m%d-%s
}
