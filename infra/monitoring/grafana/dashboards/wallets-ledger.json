{
  "__inputs": [],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" }
  ],
  "annotations": { "list": [] },
  "description": "Banzami wallet engine and double-entry ledger health",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Transfer Rate (5m)",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null }
          ]}
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "targets": [{
        "expr": "sum(rate(http_server_request_duration_seconds_count{handler=~\"/v1/transfers.*\",job=\"public-api\",http_response_status_code=~\"2..\"}[5m]))",
        "legendFormat": "transfers/s",
        "refId": "A"
      }],
      "datasource": { "type": "prometheus", "uid": "${datasource}" }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Transfer P99 Latency",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 1 },
            { "color": "red", "value": 2 }
          ]}
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "targets": [{
        "expr": "histogram_quantile(0.99, sum(rate(http_server_request_duration_seconds_bucket{handler=~\"/v1/transfers.*\",job=\"public-api\"}[5m])) by (le))",
        "legendFormat": "p99",
        "refId": "A"
      }],
      "datasource": { "type": "prometheus", "uid": "${datasource}" }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Core-API P99 Latency",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 0.5 },
            { "color": "red", "value": 1 }
          ]}
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "targets": [{
        "expr": "histogram_quantile(0.99, sum(rate(http_server_request_duration_seconds_bucket{job=\"core-api\"}[5m])) by (le))",
        "legendFormat": "p99",
        "refId": "A"
      }],
      "datasource": { "type": "prometheus", "uid": "${datasource}" }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Transfer Volume",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "lineWidth": 2, "fillOpacity": 10 } } },
      "targets": [
        {
          "expr": "sum(rate(http_server_request_duration_seconds_count{handler=~\"/v1/transfers.*\",job=\"public-api\",http_response_status_code=~\"2..\"}[5m]))",
          "legendFormat": "success",
          "refId": "A"
        },
        {
          "expr": "sum(rate(http_server_request_duration_seconds_count{handler=~\"/v1/transfers.*\",job=\"public-api\",http_response_status_code=~\"[45]..\"}[5m]))",
          "legendFormat": "failed",
          "refId": "B"
        }
      ],
      "datasource": { "type": "prometheus", "uid": "${datasource}" }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Core-API — Internal Request Latency",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "lineWidth": 2 } } },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(http_server_request_duration_seconds_bucket{job=\"core-api\"}[5m])) by (le))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_server_request_duration_seconds_bucket{job=\"core-api\"}[5m])) by (le))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_server_request_duration_seconds_bucket{job=\"core-api\"}[5m])) by (le))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "datasource": { "type": "prometheus", "uid": "${datasource}" }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Wallet Balance Reads",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 12 },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "lineWidth": 2, "fillOpacity": 5 } } },
      "targets": [{
        "expr": "sum(rate(http_server_request_duration_seconds_count{handler=~\".*wallet.*balance.*\",job=\"api-gateway\"}[5m]))",
        "legendFormat": "balance reads/s",
        "refId": "A"
      }],
      "datasource": { "type": "prometheus", "uid": "${datasource}" }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Refunds & Disputes",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 12 },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "lineWidth": 2 } } },
      "targets": [
        {
          "expr": "sum(rate(http_server_request_duration_seconds_count{handler=~\"/v1/refunds.*\",job=\"api-gateway\",http_response_status_code=~\"2..\"}[5m]))",
          "legendFormat": "refunds",
          "refId": "A"
        },
        {
          "expr": "sum(rate(http_server_request_duration_seconds_count{handler=~\"/v1/disputes.*\",job=\"api-gateway\",http_response_status_code=~\"2..\"}[5m]))",
          "legendFormat": "disputes",
          "refId": "B"
        }
      ],
      "datasource": { "type": "prometheus", "uid": "${datasource}" }
    }
  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "tags": ["banzami", "wallets", "ledger"],
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "includeAll": false,
        "name": "datasource",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "type": "datasource",
        "label": "Datasource"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Banzami — Wallets & Ledger",
  "uid": "banzami-wallets-ledger",
  "version": 1
}
