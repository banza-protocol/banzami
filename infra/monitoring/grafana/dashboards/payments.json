{
  "__inputs": [],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" }
  ],
  "annotations": { "list": [] },
  "description": "Banzami payment operations — transaction volume, latency, error rates",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Transaction Rate (5m)",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 0.5 },
            { "color": "red", "value": 2 }
          ]},
          "unit": "reqps"
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "textMode": "auto", "colorMode": "background" },
      "targets": [{
        "expr": "sum(rate(http_server_request_duration_seconds_count{handler=~\"/v1/transactions.*\",job=\"api-gateway\"}[5m]))",
        "legendFormat": "txn/s",
        "refId": "A"
      }],
      "datasource": { "type": "prometheus", "uid": "${datasource}" }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Error Rate (5m)",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 0.01 },
            { "color": "red", "value": 0.05 }
          ]},
          "unit": "percentunit",
          "max": 1
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "textMode": "auto", "colorMode": "background" },
      "targets": [{
        "expr": "sum(rate(http_server_request_duration_seconds_count{handler=~\"/v1/transactions.*\",job=\"api-gateway\",http_response_status_code=~\"5..\"}[5m])) / sum(rate(http_server_request_duration_seconds_count{handler=~\"/v1/transactions.*\",job=\"api-gateway\"}[5m]))",
        "legendFormat": "error rate",
        "refId": "A"
      }],
      "datasource": { "type": "prometheus", "uid": "${datasource}" }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "P99 Latency",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 1 },
            { "color": "red", "value": 3 }
          ]},
          "unit": "s"
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "textMode": "auto", "colorMode": "background" },
      "targets": [{
        "expr": "histogram_quantile(0.99, sum(rate(http_server_request_duration_seconds_bucket{handler=~\"/v1/transactions.*\",job=\"api-gateway\"}[5m])) by (le))",
        "legendFormat": "p99",
        "refId": "A"
      }],
      "datasource": { "type": "prometheus", "uid": "${datasource}" }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Transaction Volume",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "lineWidth": 2, "fillOpacity": 10 } } },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list" } },
      "targets": [
        {
          "expr": "sum(rate(http_server_request_duration_seconds_count{handler=~\"/v1/transactions.*\",job=\"api-gateway\",http_response_status_code=~\"2..\"}[5m]))",
          "legendFormat": "success",
          "refId": "A"
        },
        {
          "expr": "sum(rate(http_server_request_duration_seconds_count{handler=~\"/v1/transactions.*\",job=\"api-gateway\",http_response_status_code=~\"[45]..\"}[5m]))",
          "legendFormat": "error",
          "refId": "B"
        }
      ],
      "datasource": { "type": "prometheus", "uid": "${datasource}" }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "API Latency Percentiles",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "lineWidth": 2 } } },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(http_server_request_duration_seconds_bucket{job=\"api-gateway\"}[5m])) by (le))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_server_request_duration_seconds_bucket{job=\"api-gateway\"}[5m])) by (le))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_server_request_duration_seconds_bucket{job=\"api-gateway\"}[5m])) by (le))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "datasource": { "type": "prometheus", "uid": "${datasource}" }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "QR Payment Completions",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 12 },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "lineWidth": 2, "fillOpacity": 10 } } },
      "targets": [{
        "expr": "sum(rate(http_server_request_duration_seconds_count{handler=~\"/public/pay.*\",job=\"api-gateway\",http_response_status_code=~\"2..\"}[5m]))",
        "legendFormat": "QR pay completions/s",
        "refId": "A"
      }],
      "datasource": { "type": "prometheus", "uid": "${datasource}" }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Webhook Delivery",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 12 },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "lineWidth": 2 } } },
      "targets": [
        {
          "expr": "sum(rate(banzami_webhook_deliveries_total{status=\"success\"}[5m]))",
          "legendFormat": "delivered",
          "refId": "A"
        },
        {
          "expr": "sum(rate(banzami_webhook_deliveries_total{status=\"failed\"}[5m]))",
          "legendFormat": "failed",
          "refId": "B"
        }
      ],
      "datasource": { "type": "prometheus", "uid": "${datasource}" }
    }
  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "tags": ["banzami", "payments"],
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "includeAll": false,
        "name": "datasource",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "type": "datasource",
        "label": "Datasource"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Banzami — Payments",
  "uid": "banzami-payments",
  "version": 1
}
