# Banzami sandbox-edge — Stage C dedicated sandbox public routing proxy.
#
# Authority: docs/infra/BANZAMI_STAGE_C_SANDBOX_PUBLIC_ROUTING_DECISIONS.md
#   Decision 2 — a DEDICATED sandbox-edge proxy carries the sandbox public
#                routes. Extending the website edge (Option A) was rejected
#                because it would give the website upstream dependencies.
#   Decision 3 — banzami.com / www remain served by the website-only edge and
#                must not depend on sandbox/payment/admin/gateway/API services.
#   Decision 6 — no pay/checkout, no live rails, no operational Developer
#                Console, no live core-api/api-gateway/public-api.
#
# This proxy therefore serves ONLY the sandbox hosts, depends ONLY on the rt04e
# sandbox project, and shares no process, port or config with the website edge.
# It listens on its own container :443 published to a distinct host port, so the
# website edge keeps 443/8443 untouched and the two remain independent in BOTH
# directions: if this proxy dies banzami.com is unaffected, and if the website
# edge dies the sandbox routes are unaffected.
#
# FAIL-CLOSED STARTUP (the lesson from the banzami.com 522 incident, recorded in
# infra/nginx/banzami.conf): nginx resolves proxy_pass hostnames at CONFIG LOAD
# time when they are written literally, so ONE absent upstream prevented the
# whole proxy from starting. Every upstream here is therefore held in a variable
# and resolved at REQUEST time via Docker's embedded DNS. A missing upstream then
# degrades to a controlled 502/504 for that host alone — never a startup failure,
# never a false 200, never website HTML.
#
# UPSTREAM NAMING: the rt04e sandbox project generates per-deploy container
# names (they embed the deploy timestamp), so the upstreams are supplied as
# ${SB_GATEWAY} / ${SB_PUBLIC_API} / ${SB_DEVELOPER_API} and rendered by the
# nginx image's envsubst at container start. A sandbox redeploy therefore needs
# those three values refreshed and this proxy restarted — a cheap operation that
# never touches the website edge. Crucially, drift is DETECTED rather than
# silent: tools/check-sandbox-runtime.mjs proxies through this edge, so stale
# upstream names fail the runtime gate instead of quietly returning 502s.

resolver 127.0.0.11 ipv6=off valid=10s;
resolver_timeout 5s;

# ─── admin.banzami.com — BANZADMIN, the Sandbox operator control plane ───────
#
# Stage D (2026-09-08). It belongs on this edge, not the website one: the
# operator console reads the Sandbox stack, and this proxy is already on the
# Sandbox application network. Cloudflare routes the hostname here with the same
# Origin Rule that carries every other Sandbox host to 2053.
#
# Sandbox-scoped by construction — admin-api runs with ENVIRONMENT=SANDBOX
# against the Sandbox database, and there is no LIVE database for it to reach.
server {
    listen 443 ssl;
    http2 on;
    server_name admin.banzami.com;

    ssl_certificate     /etc/nginx/certs/banzami-wildcard.pem;
    ssl_certificate_key /etc/nginx/certs/banzami-wildcard.key;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;
    client_max_body_size 8m;

    # The console calls its API on the same origin it was served from, so there
    # is no CORS preflight and no second hostname to keep in step.
    location /api/ {
        # proxy_pass carrying a VARIABLE does not perform nginx's usual URI
        # replacement, so the trailing slash strips nothing and the request
        # arrives still spelled /api/… . The rewrite does it explicitly.
        # `set` must come BEFORE the rewrite. Both are rewrite-module
        # directives evaluated in order, and `break` stops the rest of them —
        # with the set after it the variable stayed empty and every API call
        # 500'd on an empty upstream.
        set $sb_admin_api "${SB_ADMIN_API}";
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass http://$sb_admin_api;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $http_cf_connecting_ip;
        proxy_set_header   X-Forwarded-For   $http_cf_connecting_ip;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    location / {
        set $sb_admin_app "${SB_ADMIN_APP}";
        proxy_pass http://$sb_admin_app;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $http_cf_connecting_ip;
        proxy_set_header   X-Forwarded-For   $http_cf_connecting_ip;
        proxy_set_header   X-Forwarded-Proto $scheme;
    }
}

# ─── sandbox-api.banzami.com — Sandbox payment/consumer API ──────────────────
server {
    listen 443 ssl;
    http2 on;
    server_name sandbox-api.banzami.com;

    ssl_certificate     /etc/nginx/certs/banzami-wildcard.pem;
    ssl_certificate_key /etc/nginx/certs/banzami-wildcard.key;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;

    client_max_body_size 10m;
    proxy_http_version 1.1;
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_connect_timeout 5s;
    proxy_read_timeout    30s;

    # Consumer public API — strip the /consumer prefix so
    #   sandbox-api.banzami.com/consumer/v1/... → public-api /v1/...
    #
    # The prefix is stripped with an explicit `rewrite ... break`, NOT with a
    # trailing slash on proxy_pass. When proxy_pass contains a VARIABLE, nginx
    # does not perform the usual URI replacement, so `proxy_pass http://$var/;`
    # silently forwards the original path: /consumer/v1/... reached public-api
    # unstripped and every consumer route 404'd. Verified against the running
    # Sandbox before and after.
    location /consumer/ {
        set $sb_public_api "${SB_PUBLIC_API}";
        rewrite ^/consumer/(.*)$ /$1 break;
        proxy_pass http://$sb_public_api;
    }

    # Everything else → the Sandbox API gateway.
    location / {
        set $sb_gateway "${SB_GATEWAY}";
        proxy_pass http://$sb_gateway;
    }
}

# ─── pay.banzami.com — the hosted payer surface (Banzami ADR-052) ────────────
# The page a payer actually opens. Every payment link the platform issues points
# here, in both environments — the published SDK maps sandbox and live to the
# same origin — so this host answering is what makes an issued link real.
#
# The upstream holds no credential: it reads the public gateway like any other
# client, and it is the only Sandbox service on the application plane alone.
server {
    listen 443 ssl;
    http2 on;
    server_name pay.banzami.com;

    ssl_certificate     /etc/nginx/certs/banzami-wildcard.pem;
    ssl_certificate_key /etc/nginx/certs/banzami-wildcard.key;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;

    client_max_body_size 1m;
    proxy_http_version 1.1;
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_connect_timeout 5s;
    proxy_read_timeout    30s;

    location / {
        set $sb_pay "${SB_PAY}";
        proxy_pass http://$sb_pay;
    }
}

# ─── checkout.banzami.com — canonical alias, not a second application ────────
# One payment page, one origin. A second application presenting the same payment
# would drift, and only one host can carry the Universal Link / App Link
# association files that bind the mobile apps. So this name canonicalises onto
# pay.banzami.com, preserving the path, rather than serving anything itself.
server {
    listen 443 ssl;
    http2 on;
    server_name checkout.banzami.com;

    ssl_certificate     /etc/nginx/certs/banzami-wildcard.pem;
    ssl_certificate_key /etc/nginx/certs/banzami-wildcard.key;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;

    # 308 preserves the method and body — a payer mid-flow is not silently
    # downgraded to a GET.
    return 308 https://pay.banzami.com$request_uri;
}

# ─── sandbox-webhook.banzami.com — CAP-WEBHOOK-001 assurance sink ────────────
# Assurance infrastructure, NOT a Banzami product API. It exists so webhook
# signing, delivery and retry can be proven against a real public HTTPS
# destination — the SSRF policy (RA-023) rightly refuses private targets, and no
# exception is added for the sink, so it has to be genuinely public.
#
# Public surface is a single capability-based ingest path. The capability is a
# per-run random token, so nothing here is enumerable and runs cannot see each
# other. The sink holds no database, no secrets and no host mounts.
server {
    listen 443 ssl;
    http2 on;
    server_name sandbox-webhook.banzami.com;

    ssl_certificate     /etc/nginx/certs/banzami-wildcard.pem;
    ssl_certificate_key /etc/nginx/certs/banzami-wildcard.key;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;

    # A webhook body is small. Anything larger is not a webhook.
    client_max_body_size 128k;
    proxy_http_version 1.1;
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_connect_timeout 5s;
    proxy_read_timeout    70s;

    # The sink's control plane is never public. Refused here, before the
    # request reaches the container — the harness reaches it over SSH instead,
    # so there is no public administration API to abuse. 404 rather than 403:
    # a 403 confirms the path exists.
    location /admin/ {
        access_log off;
        default_type application/json;
        return 404 '{"error":{"code":"NOT_FOUND","message":"not found"}}';
    }

    # Capability-based ingest — the only public path.
    #
    # The upstream is literal, unlike the API upstreams above. Those carry a
    # deployment-specific project prefix and must come from the environment; the
    # sink's container name is fixed by this repository. Keeping it literal means
    # the edge cannot render an empty upstream and fail to start if the variable
    # is ever missing — a restart hazard for the whole public perimeter, in
    # exchange for a value that was never going to vary.
    location /receive/ {
        set $sb_sink "banzami-webhook-sink:8090";
        proxy_pass http://$sb_sink;
    }

    location / {
        access_log off;
        default_type application/json;
        return 404 '{"error":{"code":"NOT_FOUND","message":"not found"}}';
    }
}

# ─── developer-api.banzami.com — Developer Platform API (Sandbox) ────────────
server {
    listen 443 ssl;
    http2 on;
    server_name developer-api.banzami.com;

    ssl_certificate     /etc/nginx/certs/banzami-wildcard.pem;
    ssl_certificate_key /etc/nginx/certs/banzami-wildcard.key;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;

    client_max_body_size 4m;
    proxy_http_version 1.1;
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_connect_timeout 5s;
    proxy_read_timeout    30s;

    # Operator-internal endpoints are NOT a public surface. developer-api mounts
    # /internal/v1/... (fixture projects, fixture keys, revocation) guarded by a
    # shared internal key, and they were reachable from the Internet through this
    # proxy simply because it forwarded everything. The guard held — no key and a
    # wrong key both return 401 — but an authenticated internal control plane
    # published on the public perimeter is a brute-force and auth-amplification
    # target that gains nothing by being reachable. Refused here, before the
    # request ever reaches the service.
    #
    # 404 rather than 403: a 403 confirms the path exists.
    location /internal/ {
        access_log off;
        default_type application/json;
        return 404 '{"error":{"code":"NOT_FOUND","message":"not found"}}';
    }

    location / {
        set $sb_developer_api "${SB_DEVELOPER_API}";
        proxy_pass http://$sb_developer_api;
    }
}

# ─── default — fail closed ───────────────────────────────────────────────────
# Any host reaching this proxy that is NOT an authorised sandbox host gets a
# controlled 503. Never website HTML, never a false 200, and never an implicit
# fallthrough into whichever server block happens to be first.
server {
    listen 443 ssl default_server;
    server_name _;

    ssl_certificate     /etc/nginx/certs/banzami-wildcard.pem;
    ssl_certificate_key /etc/nginx/certs/banzami-wildcard.key;
    ssl_protocols       TLSv1.2 TLSv1.3;

    add_header Retry-After 3600 always;
    add_header Cache-Control "no-store" always;
    default_type application/json;

    return 503 '{"error":{"code":"UNAVAILABLE","message":"host not served by the Banzami sandbox edge"}}';
}

# ─── container-local liveness ────────────────────────────────────────────────
# The container healthcheck target. Bound to the loopback INSIDE the container,
# so it is not reachable from the host, from the ingress network, or from the
# sandbox app network — nothing outside this container can see it.
#
# It exists because the obvious healthcheck does not work: busybox wget, the only
# HTTP client in nginx:alpine, has no TLS support, so probing the real
# https://127.0.0.1/ listener always exits 1. The first deployment did exactly
# that and reported `unhealthy` continuously while serving every request
# correctly — a container that works and says it does not, which is the same
# class of false signal this proxy exists to remove.
#
# Answering here proves nginx is up AND that THIS rendered template is the config
# it loaded. It deliberately says nothing about the upstreams: upstream health is
# the runtime assurance gate's job (tools/check-sandbox-runtime.mjs), kept
# separate so a proxy that is merely alive can never be mistaken for a sandbox
# that is serving.
server {
    listen 127.0.0.1:8081;
    server_name _;

    location = /edge-health {
        access_log off;
        default_type text/plain;
        return 200 'sandbox-edge ok\n';
    }

    location / {
        return 404;
    }
}
