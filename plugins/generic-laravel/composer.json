{
    "name": "banzami/banzami-laravel",
    "description": "Banzami payment gateway for Laravel \u2014 service provider, facade, and webhook middleware",
    "license": "UNLICENSED",
    "type": "library",
    "require": {
        "php": ">=8.2",
        "laravel/framework": "^12",
        "banzami/sdk-php": "@dev"
    },
    "require-dev": {
        "orchestra/testbench": "^10",
        "phpunit/phpunit": "^11"
    },
    "autoload": {
        "psr-4": {
            "Banzami\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Banzami\\Laravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Banzami\\Laravel\\BanzamiServiceProvider"
            ],
            "aliases": {
                "Banzami": "Banzami\\Laravel\\Facades\\Banzami"
            }
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../sdk/php",
            "options": {
                "symlink": true
            }
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true
}
