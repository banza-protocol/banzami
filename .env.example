# Banzami — local development environment
# Copy this file to .env and fill in the required values.
# .env is git-ignored and must NEVER be committed. (CLAUDE.md §7.3)
#
# Quick start:
#   cp .env.example .env
#   # Edit .env: set JWT_SECRET, ADMIN_API_KEY, and the account IDs
#   make dev-up
#   make db-migrate
#   make gateway-run     (terminal 1)
#   make admin-api-run   (terminal 2)
#   cd core && cargo run --bin core-api  (terminal 3)

# ─── Database ─────────────────────────────────────────────────────────────────
# Port 5433 avoids conflicts with a local PostgreSQL on 5432.
DATABASE_URL=postgres://banzami:banzami_dev@localhost:5433/banzami_dev

# ─── Cache & coordination ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_ADDR=localhost:6379

# ─── Rust core-api (:8081) ────────────────────────────────────────────────────
CORE_API_PORT=8081
CORE_API_URL=http://127.0.0.1:8081

# Ledger account IDs — generate once and persist across restarts.
# Generate with: uuidgen | tr '[:upper:]' '[:lower:]'
TRANSIT_ACCOUNT_ID=
BANK_ACCOUNT_ID=

# ─── Go api-gateway (:8080) ───────────────────────────────────────────────────
PORT=8080

# HS256 signing key for JWTs. Required before the auth middleware is enabled.
# Generate with: openssl rand -hex 32
JWT_SECRET=

# ─── Go admin-api (:8082) ─────────────────────────────────────────────────────
ADMIN_API_PORT=8082

# Shared secret for the X-Admin-Key header. Keep this out of logs and code.
# Generate with: openssl rand -hex 32
ADMIN_API_KEY=

# ─── Go public-api (:8083) ────────────────────────────────────────────────────
PUBLIC_API_PORT=8083

# ─── Observability ────────────────────────────────────────────────────────────
# OTLP_ENDPOINT — leave empty to disable tracing (metrics always active via /metrics).
# When running the full stack: http://otel-collector:4318
OTLP_ENDPOINT=

# ─── Runtime ──────────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=debug
LOG_FORMAT=pretty
