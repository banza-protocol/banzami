# Banzami — local development environment
# Copy this file to .env and adjust values as needed.
# .env is git-ignored and must NEVER be committed. (CLAUDE.md §7.3)

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Port 5433 avoids conflicts with a local PostgreSQL instance on 5432.
DATABASE_URL=postgres://banzami:banzami_dev@localhost:5433/banzami_dev

# ---------------------------------------------------------------------------
# Cache & coordination
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# Application runtime
# ---------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=debug
LOG_FORMAT=pretty   # pretty | json

# ---------------------------------------------------------------------------
# API Gateway
# ---------------------------------------------------------------------------
PORT=8080
# JWT_SECRET must be set before auth middleware is enabled.
# Generate with: openssl rand -hex 32
JWT_SECRET=
