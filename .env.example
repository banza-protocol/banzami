# Banzami — local development environment
# Copy this file to .env and fill in the required values.
# .env is git-ignored and must NEVER be committed. (CLAUDE.md §7.3)
#
# Quick start:
#   cp .env.example .env
#   # Edit .env: set JWT_SECRET, ADMIN_API_KEY, and the account IDs
#   make dev-up
#   make db-migrate
#   make gateway-run     (terminal 1)
#   make admin-api-run   (terminal 2)
#   cd core && cargo run --bin core-api  (terminal 3)

# ─── Database ─────────────────────────────────────────────────────────────────
# Port 5433 avoids conflicts with a local PostgreSQL on 5432.
DATABASE_URL=postgres://banzami:banzami_dev@localhost:5433/banzami_dev

# ─── Cache & coordination ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_ADDR=localhost:6379

# ─── Rust core-api (:8081) ────────────────────────────────────────────────────
CORE_API_PORT=8081
CORE_API_URL=http://127.0.0.1:8081

# Ledger account IDs — generate once and persist across restarts.
# Generate with: uuidgen | tr '[:upper:]' '[:lower:]'
TRANSIT_ACCOUNT_ID=
BANK_ACCOUNT_ID=
# Operator-fee REVENUE account (Banzami ADR-021). Internal account the per-payment
# operator fee is credited to — never a merchant wallet. Pin and persist it.
OPERATOR_FEE_REVENUE_ACCOUNT_ID=

# ─── Go api-gateway (:8080) ───────────────────────────────────────────────────
PORT=8080

# HS256 signing key for JWTs. MANDATORY — the gateway refuses to start without
# it (minimum 32 characters). Leaving it empty is not "auth disabled": an empty
# HMAC key is a valid HS256 key, so every merchant token would be forgeable.
# Generate with: openssl rand -hex 32
JWT_SECRET=

# ─── Go admin-api (:8082) ─────────────────────────────────────────────────────
ADMIN_API_PORT=8082

# Shared secret for the X-Admin-Key header. Keep this out of logs and code.
# Generate with: openssl rand -hex 32
ADMIN_API_KEY=

# ─── Go public-api (:8083) ────────────────────────────────────────────────────
PUBLIC_API_PORT=8083

# ─── SMTP (email de boas-vindas ao comerciante) ───────────────────────────────
# Deixar SMTP_HOST vazio desativa o envio de emails (apenas aviso no log).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@banzami.com
SMTP_FROM_NAME=Banzami

# ─── Observability ────────────────────────────────────────────────────────────
# OTLP_ENDPOINT — leave empty to disable tracing (metrics always active via /metrics).
# When running the full stack: http://otel-collector:4318
OTLP_ENDPOINT=

# ─── Runtime ──────────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=debug
LOG_FORMAT=pretty

# ─── ADR-046 unified developer key authority (Release Train 02) ───────────────
# Shared internal secret: the Gateway authenticates to developer-api's key
# introspection endpoint (POST /internal/v1/keys/authorize). Set the SAME value
# in both the developer-api and api-gateway(-staging) environments. Empty on the
# Gateway → the developer-key path (GET /v1/me) is disabled (feature-flagged).
DEVELOPER_INTERNAL_KEY=
# Gateway → developer-api base URL (internal network), e.g. http://developer-api:8086
DEVELOPER_API_URL=
