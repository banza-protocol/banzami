{
  "name": "@banzami/checkout",
  "version": "0.1.0",
  "description": "Embeddable Banzami payment checkout for any website",
  "license": "UNLICENSED",
  "main": "./dist/checkout.cjs",
  "module": "./dist/checkout.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/checkout.mjs",
      "require": "./dist/checkout.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-iife.js",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "typescript": "^5.4.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=18"
  }
}
