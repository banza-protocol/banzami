{
  "name": "@banzami/sdk",
  "version": "0.1.0",
  "description": "Official JavaScript/TypeScript SDK for the Banzami payment platform",
  "license": "UNLICENSED",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./theme": {
      "import": "./dist/theme/index.js",
      "types": "./dist/theme/index.d.ts"
    },
    "./money": {
      "import": "./dist/money.js",
      "types": "./dist/money.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build":      "tsc --project tsconfig.build.json",
    "typecheck":  "tsc --noEmit",
    "clean":      "rm -rf dist",
    "test":       "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "vitest": "^4.1.6"
  }
}
