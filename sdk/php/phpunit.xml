<?xml version="1.0" encoding="UTF-8"?>
<!--
  Without this file `vendor/bin/phpunit` has no test suite to run: it prints its
  usage text and exits 0, which reads as "nothing to report" rather than "nothing
  ran". The three test files here were never executed by any command.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         failOnWarning="true"
         failOnRisky="true"
         cacheDirectory=".phpunit.cache">
  <testsuites>
    <testsuite name="banzami-sdk-php">
      <directory>tests</directory>
    </testsuite>
  </testsuites>
  <source>
    <include>
      <directory>src</directory>
    </include>
  </source>
</phpunit>
